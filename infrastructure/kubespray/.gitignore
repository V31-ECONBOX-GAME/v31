# The repo root ignores bin/ for Eclipse. This tree's bin/ holds pinned tooling.
!/bin/

# Kubespray checkout and its Python venv: build inputs, pinned in versions.env.
/.kubespray/
/.venv/

# Kubespray writes cluster secrets here (bootstrap token, certificate key) and a
# kubeconfig with an embedded client cert. Never commit either.
# credentials_dir + artifacts_dir, both {{ inventory_dir }}-relative.
/inventory/*/credentials/
/inventory/*/artifacts/

# etcd snapshots pulled down by the backup procedure in docs/runbook.md.
/backup/
