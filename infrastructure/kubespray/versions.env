# Single source of truth for every version the command blocks in README.md and
# docs/ reference. `source versions.env` before running any of them; the docs
# never spell a number out.
#
# These are mirrors. The authoritative copy of each is named on the line above
# it, and the two must not drift -- change the authoritative file, then this one.

# Resolved so the command blocks work from any cwd.
V31_K8S_ROOT="${V31_K8S_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)}"
V31_INV="$V31_K8S_ROOT/inventory/v31"

# Kubespray itself. No committed file pins this -- it appears only in comments,
# so this line is the pin. A Kubespray release determines Calico, etcd, CoreDNS,
# runc and containerd versions, so it is the highest-leverage number here.
KUBESPRAY_VERSION="v2.32.0"
KUBESPRAY_REPO="https://github.com/kubernetes-sigs/kubespray.git"
# Build input, not V31 source: cloned, never vendored. See .gitignore.
KUBESPRAY_SRC="${KUBESPRAY_SRC:-$V31_K8S_ROOT/.kubespray}"
KUBESPRAY_VENV="${KUBESPRAY_VENV:-$V31_K8S_ROOT/.venv}"

# inventory/v31/group_vars/k8s_cluster/k8s-cluster.yml : kube_version
KUBE_VERSION="1.36.4"

# Ships with KUBESPRAY_VERSION; not independently pinned.
CALICO_VERSION="3.31.7"

# inventory/v31/group_vars/all/kube-vip.yml : kube_vip_version
KUBE_VIP_VERSION="1.2.4"
# inventory/v31/group_vars/all/all.yml : kube_vip_address
KUBE_VIP_ADDRESS="192.168.139.240"

# istio/versions.yml : istio_version, gateway_api_version, helm_version
ISTIO_VERSION="1.31.1"
ISTIO_CHART_REGISTRY="oci://ghcr.io/istio/release/charts"
GATEWAY_API_VERSION="v1.6.2"
GATEWAY_API_CHANNEL="standard"
HELM_VERSION="v3.22.0"
# istio/helmfile.yaml : every third-party chart. Helmfile owns install order and
# drift detection; nothing here shells out to `helm upgrade` by hand any more.
HELMFILE_VERSION="1.8.0"
# istio/versions.yml : helm_diff_version. helmfile apply is built on this plugin.
HELM_DIFF_VERSION="3.15.15"

export V31_K8S_ROOT V31_INV \
  KUBESPRAY_VERSION KUBESPRAY_REPO KUBESPRAY_SRC KUBESPRAY_VENV \
  KUBE_VERSION CALICO_VERSION \
  KUBE_VIP_VERSION KUBE_VIP_ADDRESS \
  HELMFILE_VERSION HELM_DIFF_VERSION \
  ISTIO_VERSION ISTIO_CHART_REGISTRY GATEWAY_API_VERSION GATEWAY_API_CHANNEL HELM_VERSION
