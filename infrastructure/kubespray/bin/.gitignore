# Downloaded by `make tools`, pinned by checksums.txt, never committed: these are
# build inputs the same way .kubespray/ and .venv/ are. Everything else in bin/ is
# source and stays tracked - the negations below say so explicitly, because the
# repo root ignores every directory named bin/.
/helm
/kubectl
/istioctl

!.gitignore
!checksums.txt
!kubespray.sh
